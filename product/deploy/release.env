# Pinned Onyx release for the 22nd X AI deployment. This file has no secrets.
# make-env.sh copies these values into the deployment .env.
# Source: upstream tag v4.8.4. The images carry the same revision label.
ONYX_RELEASE_TAG=v4.8.4
ONYX_RELEASE_COMMIT=d15d4451607965e0e349aad231f858596e85ea52

# Digests recorded on 2026-10-03 from the linux/amd64 pull of each v4.8.4 tag.
ONYX_BACKEND_IMAGE=onyxdotapp/onyx-backend:v4.8.4@sha256:df7dbe02631587c9383ccdb07faa39a69f572e58eeb895f0df6ded9778b0aafd
# Web image: our 22nd X AI build of the v4.8.4 frontend (product/branding/web-overlay,
# axi-build-web.yml run 3). Rollback: set the official image line below instead.
ONYX_WEB_SERVER_IMAGE=ghcr.io/ravi3594444/onyx1/onyx-web-server:v4.8.4-axi.3@sha256:319d511b2cbf890c7029c91240b90c4b0f953f3ea517892a62057be4dcf71101
# Official v4.8.4 web image (previous value):
# ONYX_WEB_SERVER_IMAGE=onyxdotapp/onyx-web-server:v4.8.4@sha256:9a5049f57dae444fa0c7bacbea60174598af8d6e624579ff45a0bbd26975a030
# Cloud web image for the multi-tenant stacks (project onyx-saas): the same frontend built
# with NEXT_PUBLIC_CLOUD_ENABLED=true (cloud sign-up and invite pages). vm-bootstrap.sh cutover
# writes it as ONYX_WEB_SERVER_IMAGE into the saas .env. make-env.sh does not read this key.
ONYX_WEB_SERVER_IMAGE_CLOUD=ghcr.io/ravi3594444/onyx1/onyx-web-server:v4.8.4-axi-cloud.5@sha256:817ba99ec9ab9ea4cf31abc6efbac8de4dc89c1ed5f2b62cb3c1add7f501324c
ONYX_MODEL_SERVER_IMAGE=onyxdotapp/onyx-model-server:v4.8.4@sha256:2acf61ff814007071be9c941f09855df377c9ba411bfd356b11c92c479b47850
# Cloud backend image for the production multi-tenant stack (project onyx-saas): v4.8.4 with
# product/deploy/backend-patch (platform model and knowledge rules for every new company).
# vm-bootstrap.sh saas_prepare writes it as ONYX_BACKEND_IMAGE into the saas .env and stops
# while it is empty. make-env.sh and deploy-remote.sh do not read this key.
# set after axi-build-backend.yml runs
ONYX_BACKEND_IMAGE_CLOUD=ghcr.io/ravi3594444/onyx1/onyx-backend:v4.8.4-axi.4@sha256:d044c43011af5b2ed7facee66ec6dd89597fe1475c1a502d7abf11eb3d7f9556

# Tool images of the production multi-tenant stack (product/deploy/mt/compose.tools.yml).
# vm-bootstrap.sh saas_prepare writes them into the saas .env. make-env.sh, deploy-remote.sh
# and the single-tenant stack do not read them. Digests recorded on 2026-10-05 from Docker Hub.
# Code interpreter API (its own release line, 0.4.7; upstream docker-compose.yml pins the tag).
CODE_INTERPRETER_IMAGE=onyxdotapp/code-interpreter:0.4.7@sha256:e4d3e4d875309b90aaad810373dd8ea368e6692ffec6ac36b9eb2ea7f77f97f6
# The executor image that the code interpreter starts for every run (0.4.7). ci-host-setup
# and saas-update pre-pull it into the executor Docker daemon.
PYTHON_EXECUTOR_IMAGE=onyxdotapp/python-executor-sci@sha256:94dda93e6cb56847cfc5a250db0519eb2972def88791e85aeef04989906bb4bf
# ci-gateway: the nginx image of the upstream nginx service (same tag 1.25.5-alpine),
# manifest list digest for all platforms.
CI_GATEWAY_IMAGE=nginx:1.25.5-alpine@sha256:516475cc129da42866742567714ddc681e5eed7b9ee0b9e9c015e464b4221a00
# SearXNG, the web search of every company.
SEARXNG_IMAGE=searxng/searxng:2026.10.4-d48c4b555@sha256:76b0bf285aca014c7191fc4d9234c4bfb358624ac33d8883833d496c059ec072
