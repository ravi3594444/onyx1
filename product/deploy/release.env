# Pinned Onyx release for the 22nd X AI deployment. This file has no secrets.
# make-env.sh copies these values into the deployment .env.
# Source: upstream tag v4.8.4. The images carry the same revision label.
ONYX_RELEASE_TAG=v4.8.4
ONYX_RELEASE_COMMIT=d15d4451607965e0e349aad231f858596e85ea52

# Digests recorded on 2026-10-03 from the linux/amd64 pull of each v4.8.4 tag.
ONYX_BACKEND_IMAGE=onyxdotapp/onyx-backend:v4.8.4@sha256:df7dbe02631587c9383ccdb07faa39a69f572e58eeb895f0df6ded9778b0aafd
# Web image: our 22nd X AI build of the v4.8.4 frontend (product/branding/web-overlay,
# axi-build-web.yml run 1). Rollback: set the official image line below instead.
ONYX_WEB_SERVER_IMAGE=ghcr.io/ravi3594444/onyx1/onyx-web-server:v4.8.4-axi.1@sha256:055acb433b07ae35355395baf7142c5a3a07ac3b73eaf029e44aff3ac105ed43
