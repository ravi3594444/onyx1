22nd X AI: apply the platform defaults when a tenant is set up.
Apply from the backend/ export root: patch -p1 --forward --batch --fuzz=0 < 0001-tenant-defaults-hook.patch

--- a/ee/onyx/server/tenants/provisioning.py
+++ b/ee/onyx/server/tenants/provisioning.py
@@ -25,6 +25,7 @@
     drop_schema,
     run_alembic_migrations,
 )
+from onyx.axi.tenant_defaults import apply_platform_defaults
 from onyx.configs.app_configs import (
     ANTHROPIC_DEFAULT_API_KEY,
     AUTO_PROVISION_DEFAULT_LLM_PROVIDERS,
@@ -760,6 +761,16 @@
             )
             setup_onyx(db_session, tenant_id, cohere_enabled=cohere_enabled)
 
+            # 22nd X AI platform defaults. A failure must not stop tenant creation:
+            # python -m onyx.axi.backfill repairs the tenant later.
+            try:
+                apply_platform_defaults(db_session)
+            except Exception:
+                db_session.rollback()
+                logger.exception(
+                    "Failed to apply platform defaults to tenant %s", tenant_id
+                )
+
     except Exception as e:
         logger.exception("Failed to set up tenant %s", tenant_id)
         raise e
