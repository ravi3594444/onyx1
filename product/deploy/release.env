# Cloud web image for the multi-tenant stacks (project onyx-saas): the same frontend built
# with NEXT_PUBLIC_CLOUD_ENABLED=true (cloud sign-up and invite pages). vm-bootstrap.sh cutover
# writes it as ONYX_WEB_SERVER_IMAGE into the saas .env. make-env.sh does not read this key.
ONYX_WEB_SERVER_IMAGE_CLOUD=ghcr.io/ravi3594444/onyx1/onyx-web-server:v4.8.4-axi-cloud.5@sha256:817ba99ec9ab9ea4cf31abc6efbac8de4dc89c1ed5f2b62cb3c1add7f501324c
